# =========================================================================
# CloudPilot AI — Environment Configuration
# =========================================================================

# App Environment: development | production | test
ENVIRONMENT=development
PROJECT_NAME="CloudPilot AI"

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_64_character_hex_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite fallback for immediate testing without external DB:
DATABASE_URL=sqlite:///./cloudpilot.db

# Production PostgreSQL:
# DATABASE_URL=postgresql://cloudpilot:CloudPilotPass2026!@localhost:5432/cloudpilot_db
POSTGRES_USER=cloudpilot
POSTGRES_PASSWORD=CloudPilotPass2026!
POSTGRES_DB=cloudpilot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090

# Deployment Engine Settings
DEPLOYMENT_TARGET_DEFAULT=local_docker
BUILD_TIMEOUT_SECONDS=300
MAX_CONCURRENT_BUILDS=3
HEALTH_CHECK_TIMEOUT_SECONDS=60

# Optional GitHub OAuth / PAT integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Optional AWS Integration (Cloud Adapter)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
